{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoC AutoFarm",
  "version": "0.2.1-beta.2",
  "identifier": "com.thomaslrpn.cocautofarm",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoC AutoFarm",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://api.github.com; img-src 'self' data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "thomaslrpn",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "copyright": "© 2026 thomaslrpn",
    "category": "Utility",
    "shortDescription": "Assistant d'analyse du farm sur Clash of Clans",
    "longDescription": "CoC AutoFarm observe Clash of Clans (Google Play Games), analyse les villages rencontrés et calcule leur rentabilité. Outil d'analyse uniquement : il n'automatise aucune action dans le jeu.",
    "windows": {
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "../branding/installer-header.bmp",
        "sidebarImage": "../branding/installer-sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxOUU0RkJEMEUxMDZEOTEKUldTUmJSQU92VStla1RJR1UrdlNYZlp0RkxLL28wdmlrSG1abWRUMmlyUzRMUjVzN1ZTNGJ4TG8K",
      "endpoints": [
        "https://github.com/thomaslrpn/CocFarmAuto/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
